<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:ExpertTracker.ViewModels"
 x:Class="ExpertTracker.Views.ExpenseDetailsPage" x:DataType="vm:ExpenseDetailsViewModel"
 Title="Деталі витрати" BackgroundColor="#F5F7FB">
 <ScrollView><VerticalStackLayout Padding="18" Spacing="12">
  <Label Text="Редагування витрати" FontSize="24" TextColor="#172554"/>
  <Label Text="Назва" TextColor="#334155"/>
  <Entry Text="{Binding Description, Mode=TwoWay}" TextColor="#0F172A" BackgroundColor="#F8FAFC"/>
  <Label Text="Категорія" TextColor="#334155"/>
  <Entry Text="{Binding Category, Mode=TwoWay}" TextColor="#0F172A" BackgroundColor="#F8FAFC"/>
  <Label Text="Сума" TextColor="#334155"/>
  <Entry Text="{Binding AmountText, Mode=TwoWay}" Keyboard="Numeric" TextColor="#0F172A" BackgroundColor="#F8FAFC"/>
  <Label Text="{Binding DateText}" TextColor="#334155"/>
  <Label Text="{Binding Message}" TextColor="Red"/>
  <Button Text="Зберегти" Command="{Binding SaveCommand}" BackgroundColor="#2563EB" TextColor="White"/>
  <Button Text="Видалити" Command="{Binding DeleteCommand}"
    IsVisible="{Binding CanDelete}" BackgroundColor="#B91C1C" TextColor="White"/>
  <Button Text="Сфотографувати чек" Command="{Binding AttachReceiptCommand}"/>
  <Image Source="{Binding ImagePath}" HeightRequest="160" Aspect="AspectFit"/>
  <Button Text="Зберегти GPS-координати" Command="{Binding CaptureLocationCommand}"/>
  <Label Text="{Binding CoordinatesText}" TextColor="#334155"/>
  <Button Text="Назад" Command="{Binding GoBackCommand}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
